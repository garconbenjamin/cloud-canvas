{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-canvas",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canvas-d1-prod",
      "database_id": "c011345a-01c5-4ffd-96b0-d633f86c94d4",
    },
  ],

  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "canvas-assets",
    },
  ],

  "vars": {
    "VITE_WS_HOST": "cloud-canvas-sync.chinyu-official.workers.dev",
    "GOOGLE_CLIENT_ID": "",
  },
}
