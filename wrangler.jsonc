{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-canvas-sync",
  "main": "worker-durable-objects/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_SYNC",
        "class_name": "BoardSync"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardSync"]
    }
  ]
}
